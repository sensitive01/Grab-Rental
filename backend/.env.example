# ========================================================
# Vehicle Rental Platform - Environment Configuration Template
# Copy this file to .env and fill in real production secrets
# NEVER commit the real .env file with secrets to Git
# ========================================================

# Database (Supabase PostgreSQL)
# Option A: Direct Connection (Port 5432)
# DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]

# Option B: Connection Pooler - Session Mode (Port 5432) - Recommended for IPv4 / Supabase pooling
# DB_URL=jdbc:postgresql://[YOUR-POOLER-HOST].pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.[YOUR-PROJECT-REF]
# DB_PASSWORD=[YOUR-SUPABASE-DB-PASSWORD]

DB_URL=jdbc:postgresql://db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_password
JPA_DDL_AUTO=update

# Security & JWT (Secret must be at least 256-bit / 32 characters hex/base64)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS / Frontend origin
FRONTEND_URL=http://localhost:3000

# Initial Admin Seeding (For initial development/bootstrap)
SEED_ADMIN_ENABLED=true
DEFAULT_ADMIN_NAME=Super Administrator
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=Admin@123456
DEFAULT_ADMIN_PHONE=+919876543210
